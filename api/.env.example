# Copy to .env. Never commit .env. Synthetic data only in Dev.
OPENEMR_BASE_URL=http://neuratetra-openemr.centralindia.cloudapp.azure.com
OPENEMR_SITE=default
# Filled in by scripts/openemr_register.py
OPENEMR_CLIENT_ID=
OPENEMR_CLIENT_SECRET=
OPENEMR_PRIVATE_KEY_PATH=keys/openemr_private.pem
# Azure App Service: instead of the file, the PEM base64-encoded (base64 -i keys/openemr_private.pem)
# OPENEMR_PRIVATE_KEY_B64=
OPENEMR_KEY_ID=
# Which API: fhir = Clinical Notes form via FHIR (OpenEMR 7.0.3 allows system tokens only on FHIR)
#            standard = SOAP form via the Standard REST API (needs a version that accepts system tokens there)
OPENEMR_API=fhir
# Read-only system scopes only (spec B2.8)
OPENEMR_SCOPES=api:fhir system/Patient.read system/Encounter.read system/Practitioner.read system/DocumentReference.read system/Organization.read system/Appointment.read
# Dev only: the server is plain HTTP today. Set to 0 once HTTPS is on.
OPENEMR_ALLOW_INSECURE_HTTP=1

# ---- AI review (Claude) ----
# foundry = Claude in Azure AI Foundry (default) | anthropic = Anthropic API | azure_openai = GPT in Azure OpenAI
# none = rules only. An unconfigured provider also means rules only.
CNAT_AI_PROVIDER=foundry
# Foundry: the deployment name you gave Claude in your Foundry resource
CNAT_AI_MODEL=claude-opus-5-5
CNAT_AI_EFFORT=medium
CNAT_AI_FOUNDRY_RESOURCE=
CNAT_AI_FOUNDRY_API_KEY=
CNAT_AI_ANTHROPIC_API_KEY=
# Azure OpenAI (GPT): CNAT_AI_MODEL is the deployment name, e.g. gpt-4.1
CNAT_AI_AZURE_OPENAI_ENDPOINT=
CNAT_AI_AZURE_OPENAI_API_KEY=
CNAT_AI_AZURE_OPENAI_API_VERSION=2024-10-21

# ---- Database ----
# Local default is SQLite (cnat.db). Azure SQL example:
# CNAT_DATABASE_URL=mssql+pyodbc://<user>:<password>@<server>.database.windows.net:1433/<db>?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes
CNAT_DATABASE_URL=

# ---- Sign-in ----
# Local only: trust X-Dev-User / X-Dev-Role headers. Never set this in Azure (use App Service Authentication).
CNAT_DEV_AUTH=0

# ---- OpenEMR intake (draft-note polling) ----
OPENEMR_SYNC_MINUTES=5
OPENEMR_LOOKBACK_DAYS=14
OPENEMR_DEFAULT_PROGRAM=Adult Outpatient
# When OpenEMR doesn't say what kind of note it is (one of the 11 CNAT note types)
OPENEMR_DEFAULT_NOTE_TYPE=progress_individual
